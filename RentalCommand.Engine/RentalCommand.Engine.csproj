<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RentalCommand.Engine</RootNamespace>
    <!-- Share the API's User Secrets so the Engine reads the same dev DB connection in
         Development (the real password lives only in User Secrets, never committed). -->
    <UserSecretsId>d8bc1294-85ff-4b1a-a8c9-dea769437ed8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- FCM HTTP v1 push notifications (handles service-account OAuth + multicast send). -->
    <PackageReference Include="FirebaseAdmin" Version="3.1.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- NU1903 (design-time-only transitive of EF Core Design; not shipped) — see RentalCommand.Data.csproj.
         No patched System.Security.Cryptography.Xml exists yet; remove these once one ships. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-37gx-xxp4-5rgx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-w3x6-4m5h-cxqf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RentalCommand.Api\RentalCommand.Api.csproj" />
    <ProjectReference Include="..\RentalCommand.Core\RentalCommand.Core.csproj" />
    <ProjectReference Include="..\RentalCommand.Data\RentalCommand.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RentalCommand.Engine.Tests" />
    <InternalsVisibleTo Include="RentalCommand.IntegrationTests" />
  </ItemGroup>

</Project>
