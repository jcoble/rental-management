<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Android 13+ runtime push-notification permission (FirebaseMessaging.requestPermission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Voice commands are routed by the app_links plugin, not Flutter's
                 engine-level deep linking. Disabling the latter keeps go_router's
                 auth redirect from ever seeing a rentalcommand://voice/* URI. -->
            <meta-data
              android:name="flutter_deep_linking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Voice commands / Google App Actions (TSK-26).
                 Google Assistant matches a phrase declared in res/xml/shortcuts.xml
                 and fires a VIEW intent carrying a rentalcommand://voice/<action>
                 deep link, which the app_links plugin delivers to Flutter. -->
            <intent-filter android:label="Rental Command voice command">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="rentalcommand" android:host="voice"/>
            </intent-filter>
            <!-- App Links for emailed auth links. Android verifies this against
                 https://rentalcommand.net/.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true" android:label="Rental Command auth links">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="rentalcommand.net" android:pathPrefix="/reset-password"/>
                <data android:scheme="https" android:host="rentalcommand.net" android:pathPrefix="/verify-email"/>
            </intent-filter>
            <!-- Declares which App Actions capabilities this app fulfills. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Default channel for system-tray (background/killed) FCM notifications.
             Must match PushService.kAndroidNotificationChannelId. Prod uses Google
             Services; dev skips that Gradle task until a dev FCM app exists. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="rental_command_default" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
