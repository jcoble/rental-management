# RentalCommand.Engine — runtime-only Worker image (outbox dispatch).
#
# Compiled + published by the GitHub Actions deploy workflow (see Dockerfile.api):
# no SDK stage, no in-image compile. Build context is the published output (publish/engine).
#
# The Engine is a Microsoft.NET.Sdk.Worker host (Host.CreateApplicationBuilder) with NO
# Kestrel/HTTP endpoint, so it has no /health URL — the healthcheck below is process-based.
# .NET base images mirrored into our own GHCR to avoid Microsoft MCR's 429 rate limit on the
# hosted runner (see Dockerfile.api for the refresh command).
FROM ghcr.io/jcoble/rentalcommand-dotnet-aspnet:10.0
WORKDIR /app

# procps provides pgrep for the process-based healthcheck (the Worker has no HTTP).
# tesseract-ocr is used by ImageTextExtractor when Assistant:UseImageOcr=true (off by default).
RUN apt-get update \
 && apt-get install -y --no-install-recommends procps tesseract-ocr \
 && rm -rf /var/lib/apt/lists/*

# Published output (build context = publish/engine).
COPY . ./

# Pre-create the runtime data dirs owned by `app` so a fresh named volume inherits app
# ownership. The engine shares the uploads + dataprotection-keys volumes with the API; if Docker
# creates them root-owned the non-root `app` user can't write (scan processing / DP keys fail).
RUN mkdir -p /var/lib/rentalcommand/uploads /var/lib/rentalcommand/dataprotection-keys \
 && chown -R app:app /var/lib/rentalcommand

# Run as the non-root `app` user baked into the aspnet image.
USER app

ENV DOTNET_ENVIRONMENT=Production

HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=3 \
  CMD pgrep -f RentalCommand.Engine.dll > /dev/null || exit 1

ENTRYPOINT ["dotnet", "RentalCommand.Engine.dll"]
