# RentalCommand.Api — runtime-only image (PostgreSQL-backed REST API).
#
# The app is compiled and published by the GitHub Actions deploy workflow; this image only
# lays the published output onto the runtime
# base. There is NO SDK stage and NO in-image restore/build — that removed the redundant
# recompile of Core/Data/Engine that used to run inside BOTH this image and Dockerfile.engine.
#
# Build context is the published output directory (publish/api), NOT the repo root.
# .NET base images are mirrored into our own GHCR (ghcr.io/jcoble/rentalcommand-dotnet-*) so the
# deploy build does not depend on Microsoft MCR's anonymous-pull rate limit. Refresh with:
#   crane copy --platform linux/amd64 mcr.microsoft.com/dotnet/aspnet:10.0 ghcr.io/jcoble/rentalcommand-dotnet-aspnet:10.0
FROM ghcr.io/jcoble/rentalcommand-dotnet-aspnet:10.0
WORKDIR /app
EXPOSE 8080

# curl is required by the docker-compose healthcheck that hits http://localhost:8080/health.
# The aspnet:10.0 base image does not ship curl.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

# Published output (build context = publish/api).
COPY . ./

# Pre-create the runtime data dirs owned by `app` so a FRESH named volume mounted here inherits app
# ownership (Docker seeds an empty volume from the image path's owner). Otherwise Docker creates the
# volume root-owned and the non-root `app` user can't write — uploaded scans fail with
# UnauthorizedAccessException, which the API would surface as a misleading 401.
RUN mkdir -p /var/lib/rentalcommand/uploads /var/lib/rentalcommand/dataprotection-keys \
 && chown -R app:app /var/lib/rentalcommand

# Run as the non-root `app` user baked into the aspnet image.
USER app

ENV ASPNETCORE_URLS=http://+:8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -sf http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "RentalCommand.Api.dll"]
