# RentalCommand.Api - REST API (PostgreSQL-backed)
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy solution and project files first (better layer caching: restore only
# re-runs when a .csproj/.sln changes, not on every source edit).
COPY ["RentalCommand.sln", "."]
COPY ["Directory.Build.props", "."]
COPY [".runsettings", "."]
COPY ["RentalCommand.Api/RentalCommand.Api.csproj", "RentalCommand.Api/"]
COPY ["RentalCommand.Core/RentalCommand.Core.csproj", "RentalCommand.Core/"]
COPY ["RentalCommand.Data/RentalCommand.Data.csproj", "RentalCommand.Data/"]
COPY ["RentalCommand.Engine/RentalCommand.Engine.csproj", "RentalCommand.Engine/"]

# Restore just the API and its transitive project references.
RUN dotnet restore "RentalCommand.Api/RentalCommand.Api.csproj"

# Copy everything else and publish.
COPY . .
WORKDIR "/src/RentalCommand.Api"
RUN dotnet publish "RentalCommand.Api.csproj" -c Release -o /app/publish \
    /p:UseAppHost=false /p:ErrorOnDuplicatePublishOutputFiles=false

FROM base AS final
WORKDIR /app

# curl is required by the docker-compose healthcheck that hits
# http://localhost:8080/health. The aspnet:10.0 base image does not ship curl.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .

# Run as the non-root `app` user baked into the aspnet image.
USER app

ENV ASPNETCORE_URLS=http://+:8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -sf http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "RentalCommand.Api.dll"]
