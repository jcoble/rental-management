# Rental Command — environment configuration.
# Copy to .env and fill values. .env is gitignored. Used by docker-compose.yml.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# These seed the postgres container and are available only to the one-shot migration job.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rentalcommand

# Distinct restricted runtime logins. Local defaults exist in docker-compose.yml, but setting them
# explicitly makes credential rotation/testing clearer.
API_DB_PASSWORD=rentalcommand_api_dev
ENGINE_DB_PASSWORD=rentalcommand_engine_dev

# Runtime connection strings are assembled with rentalcommand_api / rentalcommand_engine.
# For local (non-Docker) dev the convention is the host Postgres on port 5434:
#   Host=localhost;Port=5434;Database=rentalcommand;Username=postgres;Password=postgres
# Inside Docker all processes reach Postgres at Host=postgres;Port=5432.

# ─── ASP.NET Core ────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ─── JWT (auth) ──────────────────────────────────────────────────────────────
# REQUIRED. Generate a 64+ char random secret, e.g.:  openssl rand -base64 48
JWT_SECRET_KEY=
JWT_ISSUER=RentalCommand
JWT_AUDIENCE=RentalCommandWeb

# Required when the atomic auth-session boundary is cut over. Independent from JWT signing so
# refresh-bearer reconstruction can be rotated/revoked without changing access-token validation.
# Generate 32+ random bytes as base64, e.g.: openssl rand -base64 32
AUTH_SESSION_CREDENTIAL_SIGNING_KEY=

# ─── Web / routing ───────────────────────────────────────────────────────────
# Origin the SvelteKit server trusts and the API allows via CORS.
WEB_ORIGIN=https://localhost
# URL the web client uses to reach the API (through Traefik, same host).
VITE_API_URL=/api

# Optional Traefik port overrides.
# TRAEFIK_HTTP_PORT=80
# TRAEFIK_HTTPS_PORT=443

# ─── Later phases (placeholders — not used in Phase 0) ───────────────────────
# Phase: AI scan -> LLM intake.
ANTHROPIC_API_KEY=
# Phase: billing / subscriptions.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Phase: transactional email.
RESEND_API_KEY=
# Phase: error monitoring.
SENTRY_DSN=
