# Rental Command — Environment Configuration
# Copy this file to .env and fill values as needed.

# API key for programmatic API access (MCP, scripts, curl)
# Leave empty in local-only development.
API_KEY=

# Origin URL for SvelteKit deployment
ORIGIN=http://localhost

# Optional Caddy port overrides
# CADDY_HTTPS_PORT=443
# CADDY_HTTP_PORT=80
