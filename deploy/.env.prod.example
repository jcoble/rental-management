# ─────────────────────────────────────────────────────────────────────────────
# Rental Command — PRODUCTION environment (rentalcommand.net)
#
# Copy this to ".env" next to where you run docker compose, then fill it in:
#     cp deploy/.env.prod.example .env
#     docker compose -f deploy/docker-compose.prod.yml up -d --build
#
# .env is gitignored — never commit real secrets. Every KEY below maps to a
# config value the app actually reads (Jwt, Cors, App, Assistant, Notifications,
# Stripe, Authentication:Google, Esign). REQUIRED keys are marked; the rest are
# optional integrations that stay dormant ("gated off") until you set them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core: domain + TLS (REQUIRED) ────────────────────────────────────────────
# The single public host. Used by Traefik routing, the ACME cert, CORS, ORIGIN,
# CSP, App:WebBaseUrl, and the SMS webhook signature base.
DOMAIN=rentalcommand.net
# Email Let's Encrypt uses for expiry notices (REQUIRED for ACME to issue a cert).
ACME_EMAIL=

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Dedicated app DB creds. POSTGRES_PASSWORD is REQUIRED and has no default —
# generate a strong one:   openssl rand -base64 32
POSTGRES_USER=rentalcommand_app
POSTGRES_PASSWORD=
POSTGRES_DB=rentalcommand

# ── JWT / auth (REQUIRED) ─────────────────────────────────────────────────────
# Symmetric signing key for access tokens. MUST be >= 32 chars (the API refuses to
# start otherwise) and MUST NOT be the committed dev placeholder. Generate one:
#     openssl rand -base64 48
JWT_SECRET_KEY=
JWT_ISSUER=RentalCommand
JWT_AUDIENCE=RentalCommandWeb

# ── App public URL + timezone (REQUIRED) ──────────────────────────────────────
# Base URL the API stamps into e-sign signing links ({url}/sign/{token}) and the
# password-reset / email-verify links. MUST be the public subdomain (https).
APP_WEB_BASE_URL=https://rentalcommand.net
# IANA tz id used by the rent-charge / late-fee / recurring-maintenance schedulers
# to decide "what local day is it". Defaults to America/New_York if unset.
APP_TIMEZONE=America/New_York

# ── LLM assistant — scan→draft, KB Q&A, daily briefing (RECOMMENDED) ──────────
# The flagship "computer does the typing" feature. Server-side only (not in CSP).
# Provider = "openai" (default) or "anthropic"; set ModelId + ApiKey to match.
#   OpenAI:    ASSISTANT_PROVIDER=openai   ASSISTANT_MODEL_ID=gpt-4o
#   Anthropic: ASSISTANT_PROVIDER=anthropic ASSISTANT_MODEL_ID=claude-... (key=sk-ant-...)
# Without a key, scanning/AI features are inert but the rest of the app works.
ASSISTANT_PROVIDER=openai
ASSISTANT_MODEL_ID=gpt-4o
ASSISTANT_API_KEY=

# ── Email transport (OPTIONAL but recommended for notices/reset emails) ───────
# Choose ONE: "SendGrid" (default) or "Smtp" (Google Workspace/Gmail, Zoho, etc.).
# Outbound email is a no-op
# (just logged) until one is configured.
EMAIL_TRANSPORT=SendGrid

#   Option A — SendGrid:
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Rental Command

#   Option B — SMTP (set EMAIL_TRANSPORT=Smtp above to use this).
#   Recommended for testing: Google Workspace/Gmail authenticated SMTP with an app password.
#   Hetzner commonly blocks outbound 465; use 587/STARTTLS when possible.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=jcoble@rentalcommand.net
SMTP_PASSWORD=
SMTP_FROM_EMAIL=jcoble@rentalcommand.net
SMTP_FROM_NAME=Rental Command

# ── SMS — SignalWire preferred, Twilio fallback (OPTIONAL) ────────────────────
# Needed only if you send tenant SMS (and only when NOTIFY_TENANTS=true below).
# SignalWire SpaceUrl e.g. your-space.signalwire.com ; FromNumber in E.164 (+1...).
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_FROM_NUMBER=
# Twilio (used only if SignalWire is not configured):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Notification / automation feature flags (default OFF for the financial ones) ──
# Drafts are never auto-sent — the landlord approves each one. Leave these off until
# you have reviewed the behaviour with real data.
NOTIFY_TENANTS=false             # enqueue tenant-facing SMS/email from automations
ENABLE_RENT_CHARGES=false        # auto-create scheduled rent payments
ENABLE_LATE_FEES=false           # auto-apply late fees past the grace window
ENABLE_RECURRING_MAINTENANCE=true # auto-create recurring work orders (per-task IsActive is the real switch)

# ── Stripe — online rent payments / autopay (OPTIONAL) ────────────────────────
# All Stripe features stay disabled until STRIPE_SECRET_KEY is set. Webhook secret
# verifies inbound events at /api/v1/payments/stripe. AllowedReturnHosts is wired to
# ${DOMAIN} automatically by the compose file. Use LIVE keys in production.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Google OAuth sign-in (OPTIONAL) ───────────────────────────────────────────
# Reusable with the EdiPlatform Google app. The authorized redirect URI in the
# Google Cloud console MUST be exactly:
#     https://rentalcommand.net/auth/google/callback
# The "Sign in with Google" button returns 501 until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── E-sign provider (OPTIONAL — native ESIGN/UETA signing is the default) ─────
# Leave ESIGN_API_KEY blank to use the built-in native signer (works out of the box,
# emails a /sign/{token} link). Set it only to switch to hosted Dropbox Sign;
# ESIGN_WEBHOOK_SECRET then verifies inbound Dropbox Sign webhooks.
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=
