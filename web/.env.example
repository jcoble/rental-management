# Web environment variables (SvelteKit). Copy to `.env` for local dev (`.env` is gitignored).
# PUBLIC_* vars are exposed to the browser and read at runtime via `$env/dynamic/public`.

# Master simulation clock (dev/test only). When 'true', the web app:
#   - inlines the Date shim into <head> (hooks.server.ts) so display time follows the sim clock,
#   - polls the anonymous GET /api/v1/dev/clock (~1s) to sync the offset,
#   - shows the floating SimClockPanel dev widget.
# Leave unset or 'false' everywhere except local dev / the E2E sim run. MUST be 'false' in production —
# it only works against an API started with Simulation:Enabled=true (non-prod). Client auth-expiry math
# always stays on the real clock regardless (see $lib/dev/real-time).
PUBLIC_SIMULATION_ENABLED=false
